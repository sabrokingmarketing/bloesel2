# Copy to .env.local for local overrides. Never commit real values.

# Postgres connection string. Leave unset locally to use the embedded PGlite
# database in .data/. On Vercel, adding Neon from the Marketplace sets this.
DATABASE_URL=

# 32+ random characters used to sign staff sessions. Required when deployed.
# Generate one with: openssl rand -base64 48
SESSION_SECRET=

# Staff PIN (4 to 8 digits) used only when the database is first created.
# Required when deployed; change it later in Admin -> Settings.
ADMIN_PIN=
