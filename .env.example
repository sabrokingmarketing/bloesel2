# Copy to .env.local for local overrides. Never commit real values.

# Postgres connection string. Leave unset locally to use the embedded PGlite
# database in .data/. On Vercel, adding Neon from the Marketplace sets this.
DATABASE_URL=

# 32+ random characters used to sign staff sessions. Required when deployed.
# Generate one with: openssl rand -base64 48
SESSION_SECRET=

# Staff PIN (4 to 8 digits) used only when the database is first created.
# Required when deployed; change it later in Admin -> Settings.
ADMIN_PIN=

# PIN recovery emails (Resend). Leave unset locally: emails go to an in-memory
# outbox (set DEV_EMAIL_LOG=1 to print them to the console while testing).
# On Vercel all three are needed for "Forgot your PIN?" to work.
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. "Bloeisel <cards@bloeiselkoffie.co.za>"
EMAIL_FROM=
# The public site address used in emailed links. On Vercel this defaults to the
# production domain, so it is only needed for a custom domain.
APP_URL=
